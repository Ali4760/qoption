rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin live sync uses the same 30-minute sign-in limit as Cloud Functions.
    match /meta/liveSync {
      allow read: if request.auth != null
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time > 0
        && request.time.toMillis() < (request.auth.token.auth_time + 1800) * 1000
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    // ── Per-user real-time sync: only the owning user may read ───────────────
    match /userSync/{uid} {
      // Staff members must NOT read this via the client SDK (they sync via meta/liveSync).
      allow read: if request.auth != null
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // ── Everything else: closed. All data access goes through Cloud Functions ─
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
