# Firebase web app configuration is also available through Firebase Hosting's /__/firebase/init.json.
# Set these public web app identifiers for development against a hosted project.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=us-central1
VITE_FIREBASE_APPCHECK_SITE_KEY=
